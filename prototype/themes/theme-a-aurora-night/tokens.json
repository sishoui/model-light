{
  "theme": {
    "id": "theme-a-aurora-night",
    "name": "极光夜空",
    "description": "深色主题，适合灯效控制场景；深蓝/近黑背景与霓虹蓝、紫点缀，突出灯光效果",
    "category": "dark",
    "ticket": "#66",
    "specDecision": "#15 原型输出（ticket #60）"
  },
  "colors": {
    "background": "#0B0F19",
    "surface": "#131B2B",
    "surfaceElevated": "#1C273A",
    "primary": "#38BDF8",
    "primaryHover": "#7DD3FC",
    "secondary": "#818CF8",
    "accent": "#C084FC",
    "textPrimary": "#F1F5F9",
    "textSecondary": "#94A3B8",
    "textTertiary": "#64748B",
    "border": "#1E293B",
    "borderFocus": "#38BDF8",
    "success": "#34D399",
    "warning": "#FBBF24",
    "error": "#F87171",
    "icon": "#CBD5E1",
    "shadow": "rgba(0,0,0,0.45)"
  },
  "navigation": {
    "tabBar": {
      "position": "bottom",
      "type": "custom",
      "tabs": [
        { "key": "home", "label": "设备", "icon": "device" },
        { "key": "me", "label": "我的", "icon": "profile" }
      ],
      "activeColor": "#38BDF8",
      "inactiveColor": "#94A3B8",
      "background": "#0B0F19",
      "border": "#1E293B",
      "height": "100rpx"
    },
    "pageStack": [
      "pages/devices/devices（设备列表，home 默认首页）",
      "pages/discover/discover（发现/扫描）",
      "pages/device-info/device-info（设备信息）",
      "pages/device/device（设备详情）",
      "pages/pin/pin（8 pins，可重命名）",
      "pages/group/group（灯组）",
      "pages/stage/stage（阶段）",
      "pages/preview/preview（3D 预览）",
      "pages/ota/ota（OTA 升级）"
    ],
    "newPagesByDecision5": [
      "pages/discover/discover",
      "pages/device-info/device-info",
      "pages/part/part"
    ],
    "transition": "wx.navigateTo 进入下一层，wx.navigateBack 返回"
  },
  "layout": {
    "screenWidth": "750rpx",
    "pagePadding": "24rpx",
    "cardRadius": "16rpx",
    "gap": "16rpx",
    "deviceListStyle": "card-list（单列，按最近见排序）",
    "detailStyle": "slide-up 抽屉 / 独立页面",
    "pinGrid": "8 pins 2×4 网格，可重命名",
    "occupiedLedStyle": "灰色置灰，不可选"
  }
}
