{
  "theme": {
    "id": "theme-c-dark-tech",
    "name": "深色科技",
    "description": "暗色赛博风主题；几乎纯黑背景与青色/品红高对比点缀，突出设备状态与实时数据",
    "category": "dark",
    "ticket": "#66",
    "specDecision": "#15 原型输出（ticket #60）"
  },
  "colors": {
    "background": "#050505",
    "surface": "#0F0F0F",
    "surfaceElevated": "#171717",
    "primary": "#00F0FF",
    "primaryHover": "#33F5FF",
    "secondary": "#FF00FF",
    "accent": "#00FF88",
    "textPrimary": "#E0E0E0",
    "textSecondary": "#888888",
    "textTertiary": "#555555",
    "border": "#2A2A2A",
    "borderFocus": "#00F0FF",
    "success": "#00FF88",
    "warning": "#FFB800",
    "error": "#FF3131",
    "icon": "#B0B0B0",
    "shadow": "rgba(0,0,0,0.6)"
  },
  "navigation": {
    "tabBar": {
      "position": "bottom",
      "type": "custom",
      "tabs": [
        { "key": "home", "label": "设备", "icon": "device" },
        { "key": "me", "label": "我的", "icon": "profile" }
      ],
      "activeColor": "#00F0FF",
      "inactiveColor": "#666666",
      "background": "#050505",
      "border": "#2A2A2A",
      "height": "100rpx"
    },
    "pageStack": [
      "pages/devices/devices（设备列表，home 默认首页）",
      "pages/discover/discover（发现/扫描）",
      "pages/device-info/device-info（设备信息）",
      "pages/device/device（设备详情）",
      "pages/pin/pin（8 pins，可重命名）",
      "pages/group/group（灯组）",
      "pages/stage/stage（阶段）",
      "pages/preview/preview（3D 预览）",
      "pages/ota/ota（OTA 升级）"
    ],
    "newPagesByDecision5": [
      "pages/discover/discover",
      "pages/device-info/device-info",
      "pages/part/part"
    ],
    "transition": "wx.navigateTo 进入下一层，wx.navigateBack 返回；me 台可拉出抽屉侧边栏"
  },
  "layout": {
    "screenWidth": "750rpx",
    "pagePadding": "24rpx",
    "cardRadius": "12rpx",
    "gap": "14rpx",
    "deviceListStyle": "网格卡片（2 列）",
    "detailStyle": "全屏详情页",
    "pinGrid": "8 pins 2×4 网格，可重命名",
    "occupiedLedStyle": "深灰置灰，不可选"
  }
}
