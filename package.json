{
  "name": "model-light",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "api"
  ],
  "scripts": {
    "test": "npm run test:api && npm run test:mini",
    "test:api": "npm test --workspace api",
    "test:mini": "node --test \"test/*.test.js\" \"test/e2e/mock/*.test.js\" \"test/e2e/runner/*.test.js\" \"test/e2e/ota-fixture/*.test.js\"",
    "test:e2e": "node test/e2e/runner/run.js",
    "test:mini:vitest": "vitest run",
    "lint": "eslint miniprogram/lib/"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "miniprogram-automator": "^0.13.0",
    "vitest": "^5.1.0"
  }
}
