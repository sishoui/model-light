## IDF project for model-light firmware (ESP32-C3FH4).
## See docs/spec.md §3.

CONFIG_IDF_TARGET="esp32c3"

# NimBLE host-only stack (§3.2 基座).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Standard Device Information Service (0x180A, §2.1) — NimBLE DIS
# is compiled out unless this Kconfig is set, and each characteristic
# needs its own enable (maps to BLE_SVC_DIS_*_READ_PERM).
CONFIG_BT_NIMBLE_DIS_SERVICE=y
CONFIG_BT_NIMBLE_SVC_DIS_MANUFACTURER_NAME=y
CONFIG_BT_NIMBLE_SVC_DIS_FIRMWARE_REVISION=y

# FreeRTOS tick 100 Hz → 25 ms budget per frame at 40 FPS (§2.10 帧时钟).
CONFIG_FREERTOS_HZ=1000

# Disable WiFi entirely — BLE-only device (§8 明确不做).
CONFIG_ESP_WIFI_ENABLED=n

# Log level.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Compiler optimization for frame task headroom.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# OTA rollback (spec §3.4): new app boots as PENDING_VERIFY until the
# running app confirms; a broken image rolls back to the other slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# §7.2 recommendation: keep the RMT ISR IRAM-resident so flash
# erase/write during OTA does not stall the (paused) LED output.
CONFIG_RMT_ISR_IRAM_SAFE=y

# Custom partition table (docs/spec.md §3.4): no factory, dual 1.5 MiB OTA
# slots ota_0/ota_1 defined in partitions.csv. Without this the build falls
# back to single-app (factory only) and esp_ota_get_next_update_partition()
# returns NULL, so OTA BEGIN fails with MLOTA_ERR_FLASH (issue #79).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-C3FH4 has 4 MB flash. partitions.csv ends at 0x330000, which does not
# fit the ESP-IDF default 2 MB flash size.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
