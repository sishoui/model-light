/* 场景页：新拟物化（#e0e5ec 底 / #ffffff 卡片 / 柔和双阴影 / 强调 #60a5fa） */
.page { padding: 24rpx; background: #e0e5ec; min-height: 100vh; }
.topbar { background: #ffffff; border-radius: 24rpx; padding: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.name { font-size: 36rpx; font-weight: 700; color: #4a5568; }
.badge { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 999rpx; }
.badge.ok { background: #e6f0fd; color: #3b82f6; }
.badge.bad { background: #fdeaea; color: #d66a6a; }
.meta { margin-top: 12rpx; color: #8a94a6; font-size: 26rpx; }
.msg { color: #60a5fa; }
.panel { margin-top: 24rpx; background: #ffffff; border-radius: 24rpx; padding: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff; }
.slot-head { margin-bottom: 8rpx; }
.slot-title { font-size: 30rpx; font-weight: 600; color: #4a5568; }
.slot-name { font-size: 28rpx; font-weight: 600; color: #60a5fa; }
.slot-warn { display: block; color: #b45309; font-size: 24rpx; margin-top: 8rpx; }
.slot-error { display: block; color: #d66a6a; font-size: 24rpx; margin-top: 8rpx; }
.slot-actions { margin-top: 16rpx; }
.slot-btn { height: 72rpx; background: #ffffff; color: #60a5fa; font-size: 28rpx; font-weight: 600;
  border-radius: 16rpx; border: none;
  box-shadow: 4rpx 4rpx 8rpx #cfd6e0, -4rpx -4rpx 8rpx #ffffff; }
.slot-btn:active { box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff; }
.slot-btn[disabled] { color: #8a94a6; opacity: 0.6; }
.slot-hint { margin-top: 12rpx; color: #8a94a6; font-size: 22rpx; }
.manage { margin-top: 24rpx; background: #ffffff; border-radius: 24rpx; padding: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff; }
.manage-head { font-size: 30rpx; font-weight: 600; color: #4a5568; margin-bottom: 12rpx; }
.manage-item { padding: 20rpx 12rpx; border-bottom: 1rpx solid #eef1f6; }
.manage-item.disabled { opacity: 0.6; }
.manage-label { font-size: 28rpx; color: #4a5568; }
.manage-item.disabled .manage-label { color: #8a94a6; }
.manage-reason { display: block; font-size: 22rpx; color: #b45309; margin-top: 4rpx; }
.manage-close { margin-top: 20rpx; height: 72rpx; background: #ffffff; color: #60a5fa;
  font-size: 28rpx; font-weight: 600; border-radius: 16rpx; border: none;
  box-shadow: 4rpx 4rpx 8rpx #cfd6e0, -4rpx -4rpx 8rpx #ffffff; }
.manage-close:active { box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff; }