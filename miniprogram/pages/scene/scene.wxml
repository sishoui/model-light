<view class="page">
  <view class="topbar">
    <view class="row">
      <text class="name">{{name}}</text>
      <view class="badge {{connected ? 'ok' : 'bad'}}">{{connected ? '已连接' : '未连接'}}</view>
    </view>
    <view class="row meta">
      <text>场景槽 0–3</text>
      <text wx:if="{{message}}" class="msg">{{message}}</text>
    </view>
  </view>

  <view wx:for="{{slots}}" wx:key="index" class="panel"
    data-slot="{{item.index}}" bindlongpress="onLongPressSlot">
    <view class="row slot-head">
      <text class="slot-title">槽 {{item.index}}</text>
      <text class="slot-name">{{item.loading ? '查询中…' : (item.empty ? '空' : item.name)}}</text>
    </view>
    <text wx:if="{{item.truncated}}" class="slot-warn">槽内容超过单帧上限（{{maxPayload}} B），设备侧已截断</text>
    <text wx:if="{{item.error}}" class="slot-error">{{item.error}}</text>
    <view class="slot-actions">
      <button class="slot-btn" data-slot="{{item.index}}" bindtap="activateSlot"
        disabled="{{!connected || activating || item.empty || item.loading}}">激活</button>
    </view>
    <view class="slot-hint">长按本卡片可管理该场景槽</view>
  </view>

  <!-- 长按槽后的管理菜单（重命名 / 另存当前编排 / 覆盖 / 清空）。
       固件 save-scene / clear-scene 命令字未实现（地图 #48），四项统一禁用+原因。 -->
  <view wx:if="{{manage.visible}}" class="manage">
    <view class="manage-head">管理槽 {{manage.slot}}</view>
    <view wx:for="{{manage.items}}" wx:key="key" class="manage-item {{item.disabled ? 'disabled' : ''}}"
      data-key="{{item.key}}" bindtap="onManageItem">
      <text class="manage-label">{{item.label}}</text>
      <text wx:if="{{item.disabled}}" class="manage-reason">{{item.reason}}</text>
    </view>
    <button class="manage-close" bindtap="onCloseManage">关闭</button>
  </view>
</view>