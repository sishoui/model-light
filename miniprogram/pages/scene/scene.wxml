<view class="page">
  <view class="topbar">
    <view class="row">
      <text class="name">{{name}}</text>
      <view class="badge {{connected ? 'ok' : 'bad'}}">{{connected ? '已连接' : '未连接'}}</view>
    </view>
    <view class="row meta">
      <text>场景槽 0–3</text>
      <text wx:if="{{message}}" class="msg">{{message}}</text>
    </view>
  </view>

  <view wx:for="{{slots}}" wx:key="index" class="panel">
    <view class="row slot-head">
      <text class="slot-title">槽 {{item.index}}</text>
      <text class="slot-name">{{item.loading ? '查询中…' : (item.empty ? '空' : item.name)}}</text>
    </view>
    <text wx:if="{{item.truncated}}" class="slot-warn">槽内容超过单帧上限（{{maxPayload}} B），设备侧已截断</text>
    <text wx:if="{{item.error}}" class="slot-error">{{item.error}}</text>
    <view class="slot-actions">
      <button class="slot-btn" data-slot="{{item.index}}" bindtap="activateSlot"
        disabled="{{!connected || activating || item.empty || item.loading}}">激活</button>
    </view>
  </view>

  <!-- TODO(固件 save-scene)：固件目前没有「保存场景到槽」命令（只有
       ACTIVATE_SCENE / SCENE_QUERY，device-control.js 无 save 方法），保存按钮
       未接线。固件增加写入命令后，在此用 arrangement-store.loadOrCreate +
       arrangement.encode 产出 TLV（槽 blob = len(2 LE)+version(2 LE)+TLV）写入。 -->
</view>