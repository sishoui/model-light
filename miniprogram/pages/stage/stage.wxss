/* 阶段 / 灯效编辑页：新拟物化（#e0e5ec 底 / #ffffff 卡片 / 柔和双阴影 / 强调 #60a5fa） */
.page { padding: 24rpx; background: #e0e5ec; min-height: 100vh; }
.panel { background: #ffffff; border-radius: 24rpx; padding: 24rpx; margin-bottom: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff; }
.panel-title { color: #4a5568; font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.panel-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.panel-head .panel-title { margin-bottom: 0; }
.head-btns { display: flex; gap: 12rpx; }
.stage-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #e6eaf0; }
.stage-row:last-child { border-bottom: none; }
.stage-main { display: flex; flex-direction: column; gap: 4rpx; flex: 1; }
.stage-name { color: #4a5568; font-size: 28rpx; font-weight: 600; }
.stage-meta { color: #8a94a6; font-size: 22rpx; }
.stage-layers { color: #8a94a6; font-size: 24rpx; }
.stage-btns { display: flex; gap: 8rpx; }
.mini-btn { margin: 0; background: #ffffff; color: #8a94a6; font-size: 22rpx; padding: 0 16rpx; line-height: 2;
  border: none; border-radius: 10rpx;
  box-shadow: 3rpx 3rpx 6rpx #cfd6e0, -3rpx -3rpx 6rpx #ffffff; }
.mini-btn.del { color: #d66a6a; }
.mini-btn:active { box-shadow: inset 2rpx 2rpx 4rpx #cfd6e0, inset -2rpx -2rpx 4rpx #ffffff; }
.mini-btn[disabled] { opacity: 0.4; }
.add-btn { margin-top: 16rpx; background: #ffffff; color: #60a5fa; font-size: 26rpx; font-weight: 600;
  border-radius: 16rpx; border: none;
  box-shadow: 4rpx 4rpx 8rpx #cfd6e0, -4rpx -4rpx 8rpx #ffffff; }
.add-btn:active { box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff; }
.field-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; }
.field-row .k { color: #8a94a6; font-size: 24rpx; }
.inp { background: #ffffff; border: none; border-radius: 10rpx; color: #4a5568; font-size: 26rpx; padding: 8rpx 16rpx; width: 200rpx; text-align: right;
  box-shadow: inset 2rpx 2rpx 4rpx #cfd6e0, inset -2rpx -2rpx 4rpx #ffffff; }
.inp.small { width: 160rpx; }
.param-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; border-top: 1rpx solid #e6eaf0; }
.param-row .k { color: #8a94a6; font-size: 24rpx; }
.color-chip { width: 80rpx; height: 48rpx; border-radius: 10rpx; border: none;
  box-shadow: 2rpx 2rpx 4rpx #cfd6e0, -2rpx -2rpx 4rpx #ffffff; }
.enum-value { color: #4a5568; font-size: 26rpx; padding: 8rpx 16rpx; background: #ffffff; border-radius: 10rpx;
  box-shadow: inset 2rpx 2rpx 4rpx #cfd6e0, inset -2rpx -2rpx 4rpx #ffffff; }
.choices { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.choice { background: #ffffff; border-radius: 14rpx; padding: 12rpx 20rpx; color: #4a5568; font-size: 24rpx; display: flex; flex-direction: column;
  box-shadow: 3rpx 3rpx 6rpx #cfd6e0, -3rpx -3rpx 6rpx #ffffff; }
.choice.disabled { opacity: 0.45; }
.choice-warn { color: #b45309; font-size: 20rpx; }
.error { color: #d66a6a; font-size: 24rpx; display: block; margin-top: 12rpx; }