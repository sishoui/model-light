.page { padding: 24rpx; }
.panel { background: #1f2937; border-radius: 16rpx; padding: 24rpx; border: 1rpx solid #374151; margin-bottom: 24rpx; }
.panel-title { color: #f9fafb; font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.legend { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 16rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; color: #9ca3af; font-size: 22rpx; }
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; }
.dot.mine { background: #22c55e; }
.dot.occupied { background: #6b7280; }
.dot.free { background: #000000; border: 1rpx solid #374151; }
.dot.draft { background: #eab308; }
.strip { display: flex; flex-wrap: wrap; gap: 8rpx; }
.px { width: 72rpx; height: 72rpx; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #374151; }
.px-i { font-size: 20rpx; color: #e5e7eb; }
.px.mine { background: #22c55e; }
.px.mine .px-i { color: #052e16; }
.px.occupied { background: #4b5563; opacity: 0.5; }
.px.free { background: #000000; }
.px.draft { background: #eab308; }
.px.draft .px-i { color: #422006; }
.hint { color: #fbbf24; font-size: 24rpx; display: block; margin-top: 12rpx; }
.error { color: #f87171; font-size: 24rpx; display: block; margin-top: 12rpx; }
.saved { color: #34d399; font-size: 24rpx; display: block; margin-top: 12rpx; }
.range-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #374151; }
.range-label { color: #f9fafb; font-size: 28rpx; font-family: monospace; }
.range-switch { display: flex; align-items: center; gap: 8rpx; }
.range-switch .k { color: #9ca3af; font-size: 22rpx; }
.del-btn { background: #7f1d1d; color: #fecaca; font-size: 22rpx; }
.stage-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #374151; }
.stage-label { color: #d1d5db; font-size: 24rpx; }
.stage-go { color: #60a5fa; font-size: 24rpx; }
.stages-btn { margin-top: 16rpx; background: #1d4ed8; color: #fff; font-size: 26rpx; }
.empty { color: #6b7280; font-size: 26rpx; padding: 24rpx 0; }
