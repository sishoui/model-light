/* 灯组编辑页：新拟物化（#e0e5ec 底 / #ffffff 卡片 / 柔和双阴影 / 强调 #60a5fa） */
.page { padding: 24rpx; background: #e0e5ec; min-height: 100vh; }
.panel { background: #ffffff; border-radius: 24rpx; padding: 24rpx; margin-bottom: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff; }
.panel-title { color: #4a5568; font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.legend { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 16rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; color: #8a94a6; font-size: 22rpx; }
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; }
.dot.mine { background: #60a5fa; }
.dot.occupied { background: #cfd6e0; }
.dot.free { background: #ffffff; box-shadow: inset 1rpx 1rpx 2rpx #cfd6e0, inset -1rpx -1rpx 2rpx #ffffff; }
.dot.draft { background: #fbbf24; }
.strip { display: flex; flex-wrap: wrap; gap: 8rpx; }
.px { width: 72rpx; height: 72rpx; border-radius: 10rpx; display: flex; align-items: center; justify-content: center;
  background: #ffffff; box-shadow: 2rpx 2rpx 4rpx #cfd6e0, -2rpx -2rpx 4rpx #ffffff; }
.px-i { font-size: 20rpx; color: #8a94a6; }
.px.mine { background: #60a5fa; box-shadow: inset 2rpx 2rpx 4rpx #3b82f6, inset -2rpx -2rpx 4rpx #7eafff; }
.px.mine .px-i { color: #ffffff; }
.px.occupied { background: #e2e6ea; box-shadow: inset 2rpx 2rpx 4rpx #cfd6e0, inset -2rpx -2rpx 4rpx #ffffff; opacity: 0.6; }
.px.free { background: #f2f4f7; box-shadow: inset 2rpx 2rpx 4rpx #cfd6e0, inset -2rpx -2rpx 4rpx #ffffff; }
.px.draft { background: #fbbf24; box-shadow: inset 2rpx 2rpx 4rpx #d99e0b, inset -2rpx -2rpx 4rpx #ffd76b; }
.px.draft .px-i { color: #ffffff; }
.hint { color: #b45309; font-size: 24rpx; display: block; margin-top: 12rpx; }
.error { color: #d66a6a; font-size: 24rpx; display: block; margin-top: 12rpx; }
.saved { color: #3b82f6; font-size: 24rpx; display: block; margin-top: 12rpx; }
.range-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #e6eaf0; }
.range-row:last-child { border-bottom: none; }
.range-label { color: #4a5568; font-size: 28rpx; font-family: monospace; }
.range-switch { display: flex; align-items: center; gap: 8rpx; }
.range-switch .k { color: #8a94a6; font-size: 22rpx; }
.del-btn { background: #ffffff; color: #d66a6a; font-size: 22rpx; border: none; border-radius: 12rpx;
  box-shadow: 3rpx 3rpx 6rpx #cfd6e0, -3rpx -3rpx 6rpx #ffffff; }
.del-btn:active { box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff; }
.stage-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #e6eaf0; }
.stage-label { color: #4a5568; font-size: 24rpx; }
.stage-go { color: #60a5fa; font-size: 24rpx; }
.stages-btn { margin-top: 16rpx; background: #ffffff; color: #60a5fa; font-size: 26rpx; font-weight: 600;
  border-radius: 16rpx; border: none;
  box-shadow: 4rpx 4rpx 8rpx #cfd6e0, -4rpx -4rpx 8rpx #ffffff; }
.stages-btn:active { box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff; }
.empty { color: #8a94a6; font-size: 26rpx; padding: 24rpx 0; }