<view class="page">
  <view class="topbar">
    <view class="row">
      <text class="name">{{name}}</text>
      <view class="badge {{connected ? 'ok' : (reconnecting ? 'warn' : 'bad')}}">
        {{connected ? '已连接' : (reconnecting ? '重连中…' : '未连接')}}
      </view>
    </view>
    <view class="row meta">
      <text>固件 {{firmwareLabel}}</text>
      <text>mode: {{modeLabel}}</text>
      <text wx:if="{{tokenLabel}}">{{tokenLabel}}</text>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-bar">{{errorMessage}}</view>
  <view wx:if="{{visitorMode}}" class="visitor-bar">来访模式：只能改编排，不能工厂重置</view>

  <view class="panel">
    <view class="panel-title">设备控制</view>
    <view class="ctrl-row">
      <text class="ctrl-label">电源</text>
      <switch class="ctrl-switch" checked="{{powerOn}}" bindchange="onTogglePower"
        disabled="{{!connected || readOnly}}" />
    </view>
    <view class="ctrl-row">
      <text class="ctrl-label">亮度</text>
      <slider class="ctrl-slider" min="0" max="100" value="{{brightness}}" bindchange="onBrightnessChange"
        show-value disabled="{{!connected || readOnly}}" />
    </view>
    <button class="push-btn scene-btn" bindtap="openScene" disabled="{{!connected}}">场景…</button>
    <text wx:if="{{transferMessage}}" class="transfer-msg">{{transferMessage}}</text>
    <text wx:else class="transfer-msg muted">控制命令需设备授予控制令牌；失败时提示原因</text>
  </view>

  <view class="panel stat-row">
    <view class="stat-col"><text class="k">限亮</text><text class="v">{{brightnessLimit === null ? '—' : brightnessLimit + '%'}}</text></view>
    <view class="stat-col"><text class="k">温度</text><text class="v">{{temperature === null ? '—' : temperature + ' °C'}}</text></view>
    <view class="stat-col"><text class="k">状态帧</text><text class="v">{{framesSeen}} 帧</text></view>
  </view>

  <view class="fold-card">
    <view class="fold-head" bindtap="onToggleFold" data-key="pins">
      <text class="fold-title">8 引脚</text>
      <text class="fold-arrow">{{folds.pins ? '▾' : '▸'}}</text>
    </view>
    <view wx:if="{{folds.pins}}">
      <view wx:for="{{pins}}" wx:key="index" class="pin-row">
        <view class="pin-line" data-pin="{{item.index}}" bindtap="openPin">
          <text class="pin-label">{{item.label}}</text>
          <text class="pin-name">{{item.name}}</text>
          <text class="pin-meta">{{item.length}} 珠 · {{item.groupCount}} 灯组</text>
          <button class="pin-count-btn" catchtap="openLedCountEditor" data-pin="{{item.index}}"
            disabled="{{!connected || readOnly}}">灯数</button>
        </view>
        <view wx:if="{{editingPin === item.index}}" class="led-count-editor">
          <text class="ctrl-label">灯珠数</text>
          <input class="led-count-input" type="number" value="{{ledCountDraft}}"
            bindinput="onLedCountInput" placeholder="0–255" />
          <button class="led-count-ok" catchtap="onLedCountConfirm" data-pin="{{item.index}}"
            disabled="{{!connected || readOnly}}">确认</button>
        </view>
      </view>
    </view>
  </view>

  <view class="fold-card">
    <view class="fold-head" bindtap="onToggleFold" data-key="push">
      <text class="fold-title">推送编排与云端恢复</text>
      <text class="fold-arrow">{{folds.push ? '▾' : '▸'}}</text>
    </view>
    <view wx:if="{{folds.push}}">
      <button class="push-btn" bindtap="pushArrangementAction"
        disabled="{{!connected || transferring || readOnly}}">
        {{transferring ? '推送中…' : '推送'}}
      </button>
      <text wx:if="{{pushVersion}}" class="transfer-msg">本机编排版本 v{{pushVersion}}</text>
      <button class="push-btn restore-btn" bindtap="restoreFromCloud"
        disabled="{{!connected || transferring}}">
        从云端恢复
      </button>
      <text class="transfer-msg muted">恢复是手动操作：只在设备与云端不一致时写回设备</text>
    </view>
  </view>

  <view class="fold-card">
    <view class="fold-head" bindtap="onToggleFold" data-key="scene">
      <text class="fold-title">场景</text>
      <text class="fold-arrow">{{folds.scene ? '▾' : '▸'}}</text>
    </view>
    <view wx:if="{{folds.scene}}">
      <button class="push-btn" bindtap="openScene" disabled="{{!connected}}">管理场景槽…</button>
      <text class="transfer-msg muted">场景槽 0–3：查询 / 激活固件存储的编排快照</text>
    </view>
  </view>

  <view class="fold-card">
    <view class="fold-head" bindtap="onToggleFold" data-key="ota">
      <text class="fold-title">固件升级（OTA）</text>
      <text wx:if="{{otaUpgrading}}" class="fold-badge">升级中</text>
      <text class="fold-arrow">{{folds.ota ? '▾' : '▸'}}</text>
    </view>
    <view wx:if="{{folds.ota}}">
      <button class="push-btn" bindtap="openOta" disabled="{{!connected}}">固件升级…</button>
      <text class="transfer-msg muted">升级期间设备暂停编排渲染，其他连接降为只读</text>
    </view>
  </view>
</view>