<view class="page">
  <view class="topbar">
    <view class="row">
      <text class="name">{{name || '设备'}}</text>
      <view class="badge {{connected ? 'ok' : (reconnecting ? 'warn' : 'bad')}}">
        {{connected ? '已连接' : (reconnecting ? '重连中…' : '未连接')}}
      </view>
    </view>
    <view class="row meta">
      <text>固件 {{firmwareLabel}}</text>
      <text>{{modeLabel}}</text>
      <text wx:if="{{tokenLabel}}">{{tokenLabel}}</text>
      <text wx:if="{{arrangementVersion !== null}}">编排 v{{arrangementVersion}}</text>
    </view>
    <view class="ota-entry" bindtap="onTapOta">
      <text class="ota-entry-title">固件升级</text>
      <text class="ota-entry-version" wx:if="{{firmwareLabel !== '—'}}">当前 {{firmwareLabel}}</text>
      <text class="ota-entry-arrow">›</text>
    </view>
    <view class="ota-entry add-entry" bindtap="onTapAdd">
      <text class="ota-entry-title">添加设备</text>
      <text class="ota-entry-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-bar">{{errorMessage}}</view>

  <view class="panel power-panel">
    <view class="ctrl-row">
      <text class="ctrl-label">整体开关</text>
      <switch class="ctrl-switch" checked="{{powerOn}}" bindchange="onTogglePower"
        disabled="{{!connected || readOnly}}" />
      <text class="power-hint">{{powerOn ? '引脚可操作' : '已全灭，卡片置灰'}}</text>
    </view>
    <text wx:if="{{transferMessage}}" class="transfer-msg">{{transferMessage}}</text>
  </view>

  <!-- 引脚卡片模板（两列网格复用）：数据经 {{...item}} 展开传入，点按/长按/置灰交互不变 -->
  <template name="pin-card">
    <view
      class="pin-card {{cover ? '' : 'no-cover'}}"
      data-pin="{{index}}"
      bindtap="onTapPin"
      bindlongpress="onLongPressPin"
    >
      <image wx:if="{{cover}}" class="card-image" src="{{cover}}" mode="aspectFill" />
      <view wx:else class="card-image image-placeholder">{{gpio}}</view>
      <view wx:if="{{cover}}" class="card-shade"></view>
      <view class="card-body">
        <view class="card-name">{{name}}<text class="gpio-inline">{{gpio}}</text></view>
        <view class="card-meta">
          <text class="state state-{{state}}">{{stateLabel}}</text>
          <text>{{groupCount}} 灯组 · {{length}} 珠</text>
        </view>
      </view>
    </view>
  </template>

  <scroll-view class="card-list" scroll-y>
    <view class="pin-grid {{powerOn ? '' : 'power-off'}}">
      <block wx:for="{{pins}}" wx:key="index">
        <template is="pin-card" data="{{...item}}" />
      </block>
    </view>
  </scroll-view>

  <!-- 长按编辑菜单（底部弹出） -->
  <view wx:if="{{menuOpen}}" class="sheet-mask" bindtap="onMenuClose">
    <view class="sheet" catchtap="noop">
      <view class="sheet-item" data-action="rename" catchtap="onMenuAction">重命名</view>
      <view class="sheet-item" data-action="cover" catchtap="onMenuAction">更换图片</view>
      <view class="sheet-cancel" catchtap="onMenuClose">取消</view>
    </view>
  </view>

  <!-- 重命名输入 -->
  <view wx:if="{{renameOpen}}" class="rename-mask" bindtap="onRenameCancel">
    <view class="rename-panel" catchtap="noop">
      <view class="rename-title">重命名 GPIO{{renamePin}}</view>
      <input class="rename-input" value="{{renameDraft}}" bindinput="onRenameInput" focus />
      <view class="rename-actions">
        <button class="btn-ghost" bindtap="onRenameCancel">取消</button>
        <button class="btn-primary" bindtap="onRenameConfirm">确认</button>
      </view>
    </view>
  </view>
</view>