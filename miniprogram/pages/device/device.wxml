<view class="page">
  <view class="topbar">
    <view class="row">
      <text class="name">{{name}}</text>
      <view class="badge {{connected ? 'ok' : (reconnecting ? 'warn' : 'bad')}}">
        {{connected ? '已连接' : (reconnecting ? '重连中…' : '未连接')}}
      </view>
    </view>
    <view class="row meta">
      <text>固件 {{firmwareLabel}}</text>
      <text>mode: {{modeLabel}}</text>
      <text wx:if="{{tokenLabel}}">{{tokenLabel}}</text>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-bar">{{errorMessage}}</view>
  <view wx:if="{{visitorMode}}" class="visitor-bar">来访模式：只能改编排，不能工厂重置</view>

  <view class="panel">
    <view class="stat"><text class="k">限亮</text><text class="v">{{brightnessLimit === null ? '—' : brightnessLimit + '%'}}</text></view>
    <view class="stat"><text class="k">温度</text><text class="v">{{temperature === null ? '—' : temperature + ' °C'}}</text></view>
    <view class="stat"><text class="k">状态帧</text><text class="v">{{framesSeen}} 帧</text></view>
  </view>

  <!-- M2 调试：推送固定编排 TLV（#15：只做传输，不做编辑界面） -->
  <view class="panel">
    <view class="stat"><text class="k">协议</text><text class="v">{{readOnly ? '只读（major 不符）' : (protoLabel || '—')}}</text></view>
    <view class="stat"><text class="k">分片</text><text class="v">{{chunkSize || '—'}} B</text></view>
    <button class="debug-btn" size="mini" bindtap="sendTestArrangement"
      disabled="{{!connected || transferring || readOnly}}">
      {{transferring ? '传输中 ' + progressLabel : '推送测试编排'}}
    </button>
    <text wx:if="{{transferMessage}}" class="transfer-msg">{{transferMessage}}</text>
  </view>

  <view class="panel">
    <view class="panel-title">引脚（0–7 固定）</view>
    <view wx:for="{{pins}}" wx:key="index" class="pin-row" data-pin="{{item.index}}" bindtap="openPin">
      <text class="pin-label">{{item.label}}</text>
      <text class="pin-name">{{item.name}}</text>
      <text class="pin-meta">{{item.length}} 珠 · {{item.groupCount}} 灯组</text>
    </view>
  </view>

  <view class="panel">
    <view class="panel-title">推送编排到设备（本地先缓存，失败不丢编辑）</view>
    <button class="push-btn" bindtap="pushArrangementAction"
      disabled="{{!connected || transferring || readOnly}}">
      {{transferring ? '推送中…' : '推送'}}
    </button>
    <text wx:if="{{pushVersion}}" class="transfer-msg">本机编排版本 v{{pushVersion}}</text>
    <button class="push-btn restore-btn" bindtap="restoreFromCloud"
      disabled="{{!connected || transferring}}">
      从云端恢复
    </button>
    <text class="transfer-msg muted">恢复是手动操作：只在设备与云端不一致时写回设备</text>
  </view>
</view>
