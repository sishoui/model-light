/* 设备页 v2（#129）样式 — 新拟物：底 #e0e5ec / 卡片 #ffffff / 柔和双阴影 / 强调 #60a5fa。
   结构：顶栏（含「固件升级 / 添加设备」入口）→ 整体开关面板 → 8 引脚卡片两列网格 → 长按菜单 → 重命名弹层。 */
.page { padding: 24rpx; background: #e0e5ec; min-height: 100vh; box-sizing: border-box; }

/* 顶栏卡片 */
.topbar { background: #ffffff; border-radius: 24rpx; padding: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.name { font-size: 36rpx; font-weight: 700; color: #4a5568; }
.meta { margin-top: 16rpx; gap: 24rpx; color: #8a94a6; font-size: 26rpx; }
.badge { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 999rpx; }
.badge.ok { background: #e6f0fd; color: #3b82f6; }
.badge.warn { background: #fdf3e3; color: #b45309; }
.badge.bad { background: #fdeaea; color: #d66a6a; }
/* 「固件升级」轻量入口（#133）：顶栏内一条次行动，不占主导航 */
.ota-entry { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; padding-top: 20rpx;
  border-top: 1rpx solid #eceff3; }
.ota-entry-title { font-size: 28rpx; color: #60a5fa; font-weight: 600; }
.ota-entry-version { font-size: 24rpx; color: #8a94a6; }
.ota-entry-arrow { margin-left: auto; font-size: 32rpx; color: #8a94a6; }
/* 「添加设备」入口：弱化为次要行动 */
.add-entry { margin-top: 12rpx; padding-top: 12rpx; }
.add-entry .ota-entry-title { color: #8a94a6; font-weight: 400; }
.error-bar { margin-top: 16rpx; background: #fdeaea; color: #d66a6a; padding: 16rpx 24rpx; border-radius: 16rpx;
  box-shadow: inset 2rpx 2rpx 4rpx #f0d5d5, inset -2rpx -2rpx 4rpx #ffffff; }

/* 整体开关面板 */
.panel { margin-top: 24rpx; background: #ffffff; border-radius: 24rpx; padding: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff; }
.ctrl-row { display: flex; align-items: center; gap: 24rpx; }
.ctrl-label { color: #4a5568; font-size: 30rpx; font-weight: 600; }
.ctrl-switch { flex-shrink: 0; }
.power-hint { color: #8a94a6; font-size: 24rpx; }
.transfer-msg { font-size: 24rpx; color: #4a5568; margin-top: 8rpx; display: block; }

/* 引脚卡片：两列网格纵向滚动（固定 8 张，不可增删；第 4 张后插「＋」行） */
.card-list { margin-top: 24rpx; height: calc(100vh - 420rpx); }
.pin-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.pin-card {
  width: calc((100% - 20rpx) / 2); height: 360rpx;
  position: relative; overflow: hidden;
  background: #ffffff; border-radius: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff;
}
/* 整体关闭：全部置灰（「＋」行不受影响） */
.power-off .pin-card { opacity: 0.45; filter: grayscale(1); }
.card-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.image-placeholder {
  display: flex; align-items: center; justify-content: center;
  background: #e6f0fd; color: rgba(59, 130, 246, 0.32); font-size: 64rpx; font-weight: 600;
}
/* 底部渐变遮罩：保证照片上的白字可读 */
.card-shade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 56%;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.62));
}
.card-body { position: absolute; left: 20rpx; right: 20rpx; bottom: 18rpx; color: #ffffff; }
.card-name { font-size: 30rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.gpio-inline { font-size: 24rpx; font-weight: 400; opacity: 0.72; margin-left: 12rpx; }
.card-meta { margin-top: 10rpx; display: flex; align-items: center; gap: 14rpx; font-size: 24rpx; opacity: 0.95; }
.state { font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.22); color: #ffffff; }
.state-on, .state-blink { background: rgba(255, 255, 255, 0.4); }

/* 无图引脚：浅蓝占位 + GPIO 水印 + 深色字 */
.pin-card.no-cover { background: #e6f0fd; }
.no-cover .card-body { color: #4a5568; }
.no-cover .card-meta { color: #8a94a6; }
.no-cover .state { background: #dce6f2; color: #8a94a6; }
.no-cover .state-on { background: #cfe0fa; color: #3b82f6; }
.no-cover .state-blink { background: #f6e7c8; color: #b45309; }

/* 「＋ 添加设备」通栏行：第 4 张引脚卡后，点击回发现页 */
.pin-add {
  width: 100%; height: 180rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
  background: #ffffff; border-radius: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff;
}
.pin-add:active { box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff; }
.pin-add-plus { font-size: 56rpx; font-weight: 300; color: #60a5fa; line-height: 1; }
.pin-add-label { font-size: 26rpx; color: #8a94a6; }

/* ---- 长按编辑菜单（底部弹出） ---- */
.sheet-mask {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.35); z-index: 50;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #e0e5ec; border-radius: 28rpx 28rpx 0 0; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}
.sheet-item { text-align: center; color: #4a5568; font-size: 30rpx; padding: 30rpx 0; border-bottom: 1rpx solid #cfd6e0; }
.sheet-cancel { text-align: center; color: #8a94a6; font-size: 28rpx; padding: 24rpx 0; }

/* ---- 重命名 ---- */
.rename-mask {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.35); z-index: 60;
  display: flex; align-items: center; justify-content: center;
}
.rename-panel {
  width: 600rpx; background: #ffffff; border-radius: 24rpx; padding: 32rpx;
  box-shadow: 8rpx 8rpx 16rpx #b9c4d4, -8rpx -8rpx 16rpx #ffffff;
}
.rename-title { color: #4a5568; font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.rename-input { background: #e0e5ec; border-radius: 16rpx; padding: 20rpx; font-size: 28rpx; color: #4a5568; }
.rename-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.btn-ghost, .btn-primary {
  flex: 1; height: 80rpx; line-height: 80rpx; border: none; border-radius: 40rpx; font-size: 28rpx; font-weight: 600;
}
.btn-ghost { background: #ffffff; color: #8a94a6; box-shadow: 4rpx 4rpx 8rpx #cfd6e0, -4rpx -4rpx 8rpx #ffffff; }
.btn-primary { background: #60a5fa; color: #ffffff; }