.page { padding: 24rpx; }
.topbar { background: #1f2937; border-radius: 16rpx; padding: 24rpx; border: 1rpx solid #374151; }
.row { display: flex; align-items: center; justify-content: space-between; }
.name { font-size: 36rpx; font-weight: 700; color: #f9fafb; }
.meta { margin-top: 16rpx; gap: 24rpx; color: #9ca3af; font-size: 26rpx; }
.badge { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 999rpx; }
.badge.ok { background: #064e3b; color: #34d399; }
.badge.warn { background: #78350f; color: #fbbf24; }
.badge.bad { background: #7f1d1d; color: #f87171; }
.error-bar { margin-top: 16rpx; background: #7f1d1d; color: #fecaca; padding: 16rpx 24rpx; border-radius: 12rpx; }
.visitor-bar { margin-top: 16rpx; background: #78350f; color: #fde68a; padding: 16rpx 24rpx; border-radius: 12rpx; }
.panel { margin-top: 24rpx; display: flex; gap: 16rpx; }
.stat { flex: 1; background: #1f2937; border-radius: 16rpx; padding: 24rpx; border: 1rpx solid #374151; }
.k { color: #9ca3af; font-size: 24rpx; display: block; }
.v { color: #f9fafb; font-size: 32rpx; margin-top: 8rpx; display: block; }

.panel .debug-btn { margin-top: 12rpx; }
.transfer-msg { font-size: 24rpx; color: #9ca3af; margin-top: 8rpx; }
.panel-title { color: #f9fafb; font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.pin-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #374151; }
.pin-label { color: #9ca3af; font-size: 26rpx; width: 110rpx; }
.pin-name { color: #f9fafb; font-size: 28rpx; flex: 1; }
.pin-meta { color: #9ca3af; font-size: 24rpx; }
.push-btn { background: #2563eb; color: #fff; font-size: 28rpx; }
