/* 3D 灯板预览页：xr-frame 画布保持深色；画布下方控件区新拟物化
   （#e0e5ec 底 / #ffffff 卡片 / 柔和双阴影 / 强调 #60a5fa） */
.page { padding: 20rpx; background: #e0e5ec; }
.topbar { margin-bottom: 16rpx; }
.badge { display: inline-block; padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 24rpx;
  background: #ffffff; color: #8a94a6;
  box-shadow: 3rpx 3rpx 6rpx #cfd6e0, -3rpx -3rpx 6rpx #ffffff; }
.badge-ok { color: #3b82f6; }
.badge-off { color: #8a94a6; }
.hint { margin-top: 12rpx; padding: 12rpx 18rpx; border-radius: 14rpx; font-size: 24rpx; background: #fdf3e3; color: #b45309; }
.hint-disconnected { background: #eef1f5; color: #8a94a6; }
.hint-version-mismatch { background: #fdeaea; color: #d66a6a; }
.hint-realtime { background: #fdf3e3; color: #b45309; }
.controls { display: flex; flex-direction: column; gap: 16rpx; background: #ffffff; border-radius: 24rpx; padding: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff; }
.row { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.label { font-size: 26rpx; color: #8a94a6; width: 120rpx; }
.seg { display: flex; }
.seg-btn { margin: 0; padding: 8rpx 24rpx; font-size: 24rpx; border-radius: 0; border: none;
  background: #ffffff; color: #8a94a6;
  box-shadow: 2rpx 2rpx 4rpx #cfd6e0, -2rpx -2rpx 4rpx #ffffff; }
.seg-btn:first-child { border-radius: 12rpx 0 0 12rpx; }
.seg-btn:last-child { border-radius: 0 12rpx 12rpx 0; }
.seg-btn.on { background: #60a5fa; color: #ffffff;
  box-shadow: inset 2rpx 2rpx 4rpx #3b82f6, inset -2rpx -2rpx 4rpx #7eafff; }
.pill { margin: 0; padding: 8rpx 28rpx; font-size: 24rpx; border-radius: 999rpx; border: none;
  background: #ffffff; color: #60a5fa;
  box-shadow: 3rpx 3rpx 6rpx #cfd6e0, -3rpx -3rpx 6rpx #ffffff; }
.pill:active { box-shadow: inset 2rpx 2rpx 4rpx #cfd6e0, inset -2rpx -2rpx 4rpx #ffffff; }
.chips { display: flex; flex-wrap: wrap; gap: 8rpx; }
.chip { margin: 0; padding: 6rpx 20rpx; font-size: 24rpx; border-radius: 999rpx; border: none;
  background: #ffffff; color: #8a94a6;
  box-shadow: 2rpx 2rpx 4rpx #cfd6e0, -2rpx -2rpx 4rpx #ffffff; }
.chip.on { background: #60a5fa; color: #ffffff;
  box-shadow: inset 2rpx 2rpx 4rpx #3b82f6, inset -2rpx -2rpx 4rpx #7eafff; }
.muted { font-size: 22rpx; color: #8a94a6; }