<view class="page">
  <!-- 版本头 -->
  <view class="ver-head">
    <text class="ver-title">模型灯效</text>
    <text class="ver-num">版本 {{version}}</text>
  </view>

  <!-- 账号状态（单列分组） -->
  <view class="group">
    <view class="row">
      <text class="row-label">账号状态</text>
      <text class="row-value {{accountKind}}">{{accountLabel}}</text>
    </view>
  </view>

  <!-- 云备份只读摘要（无按钮） -->
  <view class="group">
    <view class="row">
      <text class="row-label">上次同步</text>
      <text class="row-value">{{backupSummary.timeText}}</text>
    </view>
    <view class="row">
      <text class="row-label">备份大小</text>
      <text class="row-value">{{backupSummary.sizeText}}</text>
    </view>
    <view class="row" wx:if="{{backupSummary.behindText}}">
      <text class="row-label">云端状态</text>
      <text class="row-value warn">{{backupSummary.behindText}}</text>
    </view>
  </view>

  <!-- 日志待发数 -->
  <view class="group">
    <view class="row">
      <text class="row-label">待上报日志</text>
      <text class="row-value">{{pendingUsageText}}</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="group">
    <view class="row">
      <text class="row-label">版本</text>
      <text class="row-value">{{version}}</text>
    </view>
    <view class="row tap" bindtap="onTapPrivacy" wx:if="{{hasPrivacyGuide}}">
      <text class="row-label">隐私指引</text>
      <text class="row-value link">查看</text>
    </view>
  </view>

  <!-- 开发者选项：模拟模式（无真机演示） -->
  <view class="group">
    <view class="row">
      <text class="row-label">模拟模式</text>
      <switch checked="{{mockEnabled}}" color="#60a5fa" bindchange="onToggleMock" />
    </view>
    <view class="row">
      <text class="row-value muted">无真机时开启，重启后全流程走模拟数据</text>
    </view>
  </view>
</view>