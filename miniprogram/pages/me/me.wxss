.page { padding: 40rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.card { background: #1f2937; border-radius: 20rpx; padding: 40rpx; border: 1rpx solid #374151; text-align: center; }
.title { font-size: 40rpx; font-weight: 700; color: #f9fafb; margin-bottom: 8rpx; }
.hint { font-size: 28rpx; color: #9ca3af; margin-bottom: 16rpx; }
.meta { font-size: 24rpx; color: #6b7280; }
