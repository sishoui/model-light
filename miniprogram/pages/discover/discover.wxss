/* 设备列表页（主页）样式 — 新拟物：底 #e0e5ec / 卡片 #ffffff / 双向阴影 / 强调 #60a5fa。
   结构：空态 → 设备卡片列表 → 末尾添加卡片 → 添加流程 → 长按菜单 → 重命名。 */
.page { padding: 24rpx; background: #e0e5ec; min-height: 100vh; box-sizing: border-box; }

/* ---- 空态 ---- */
.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 160rpx 48rpx; }
.empty-illustration {
  width: 200rpx; height: 200rpx; border-radius: 50%; background: #ffffff;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 8rpx 8rpx 16rpx #cfd6e0, -8rpx -8rpx 16rpx #ffffff;
}
.empty-illustration-inner { font-size: 88rpx; }
.empty-title { margin-top: 40rpx; color: #4a5568; font-size: 36rpx; font-weight: 700; }
.empty-desc { margin-top: 12rpx; color: #8a94a6; font-size: 26rpx; text-align: center; }
.btn-add {
  margin-top: 48rpx; width: 420rpx; height: 88rpx; line-height: 88rpx;
  background: #60a5fa; color: #ffffff; font-size: 30rpx; font-weight: 600;
  border: none; border-radius: 44rpx;
  box-shadow: 6rpx 6rpx 12rpx #b9c4d4, -6rpx -6rpx 12rpx #ffffff;
}
.btn-add:active { box-shadow: inset 4rpx 4rpx 8rpx #3f7fd0, inset -4rpx -4rpx 8rpx #8fc0ff; }

/* ---- 设备卡片列表 ---- */
.cards { display: flex; flex-direction: column; gap: 20rpx; }
.device-card {
  display: flex; align-items: center; gap: 20rpx;
  background: #ffffff; border-radius: 24rpx; padding: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff;
}
.device-card.selected {
  box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff;
  border: 2rpx solid #60a5fa;
}
.cover {
  width: 104rpx; height: 104rpx; border-radius: 20rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff;
}
.cover-a { background: #e6f0fd; }
.cover-b { background: #eafaf0; }
.cover-c { background: #fdf3e3; }
.cover-d { background: #f3eafd; }
.cover-icon { font-size: 52rpx; }
.cover-add { background: #eef1f6; color: #60a5fa; font-size: 52rpx; font-weight: 300; }
.body { flex: 1; min-width: 0; }
.name { color: #4a5568; font-size: 30rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.summary { margin-top: 10rpx; display: flex; align-items: center; gap: 16rpx; }
.online { font-size: 24rpx; padding: 2rpx 14rpx; border-radius: 999rpx; }
.online.on { background: #e6f0fd; color: #3b82f6; }
.online.off { background: #eceff3; color: #8a94a6; }
.count { color: #8a94a6; font-size: 24rpx; }
.add-label { color: #60a5fa; font-weight: 600; }

/* ---- 添加设备流程 ---- */
.add-flow {
  margin-top: 24rpx; background: #ffffff; border-radius: 24rpx; padding: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff;
}
.add-flow-head { display: flex; align-items: center; justify-content: space-between; }
.add-flow-title { color: #4a5568; font-size: 30rpx; font-weight: 600; }
.add-flow-close { color: #60a5fa; font-size: 26rpx; }
.error { color: #d66a6a; padding: 16rpx 0; text-align: center; font-size: 26rpx; }
.scan-list { margin-top: 16rpx; }
.scan-empty { color: #8a94a6; font-size: 26rpx; padding: 24rpx 0; text-align: center; }
.scan-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 1rpx solid #e6eaf0;
}
.scan-row:last-child { border-bottom: none; }
.scan-name { color: #4a5568; font-size: 28rpx; font-weight: 600; }
.scan-meta { color: #8a94a6; font-size: 22rpx; font-family: monospace; }
.connecting { color: #8a94a6; font-size: 26rpx; padding: 24rpx 0; text-align: center; }

/* ---- 长按编辑菜单（底部弹出） ---- */
.sheet-mask {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.35); z-index: 50;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #e0e5ec; border-radius: 28rpx 28rpx 0 0; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}
.sheet-item { text-align: center; color: #4a5568; font-size: 30rpx; padding: 30rpx 0; border-bottom: 1rpx solid #cfd6e0; }
.sheet-item.danger { color: #d66a6a; border-bottom: none; }
.sheet-cancel { text-align: center; color: #8a94a6; font-size: 28rpx; padding: 24rpx 0; }

/* ---- 重命名 ---- */
.rename-mask {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.35); z-index: 60;
  display: flex; align-items: center; justify-content: center;
}
.rename-panel {
  width: 600rpx; background: #ffffff; border-radius: 24rpx; padding: 32rpx;
  box-shadow: 8rpx 8rpx 16rpx #b9c4d4, -8rpx -8rpx 16rpx #ffffff;
}
.rename-title { color: #4a5568; font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.rename-input { background: #e0e5ec; border-radius: 16rpx; padding: 20rpx; font-size: 28rpx; color: #4a5568; }
.rename-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.btn-ghost, .btn-primary {
  flex: 1; height: 80rpx; line-height: 80rpx; border: none; border-radius: 40rpx; font-size: 28rpx; font-weight: 600;
}
.btn-ghost { background: #ffffff; color: #8a94a6; box-shadow: 4rpx 4rpx 8rpx #cfd6e0, -4rpx -4rpx 8rpx #ffffff; }
.btn-primary { background: #60a5fa; color: #ffffff; }

/* ---- 调试（模拟）模式横幅 ---- */
.debug-bar {
  position: fixed; left: 24rpx; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; gap: 12rpx;
  background: #fff7e6; border: 2rpx solid #f0c36d; border-radius: 20rpx;
  padding: 18rpx 24rpx; z-index: 40;
  box-shadow: 4rpx 4rpx 8rpx #cfd6e0, -4rpx -4rpx 8rpx #ffffff;
}
.debug-bar:active { background: #ffedc2; }
.debug-dot { color: #e6a23c; font-size: 22rpx; }
.debug-text { flex: 1; color: #b8860b; font-size: 26rpx; font-weight: 600; }
.debug-action { color: #d66a6a; font-size: 26rpx; font-weight: 600; }