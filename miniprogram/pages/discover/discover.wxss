.page { padding: 24rpx; background: #e0e5ec; min-height: 100vh; }
.title { font-size: 40rpx; font-weight: 700; color: #4a5568; padding: 16rpx 0 24rpx; }
.section { margin-bottom: 32rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #8a94a6; margin-bottom: 16rpx; }
.empty-inline { color: #8a94a6; font-size: 26rpx; padding: 16rpx 0; }
.toolbar { margin-bottom: 24rpx; display: flex; align-items: center; justify-content: space-between; }
.error { color: #d66a6a; padding: 16rpx 0; text-align: center; }
.empty { color: #8a94a6; padding: 48rpx 0; text-align: center; }
.list { display: flex; flex-direction: column; gap: 16rpx; }
.device-card {
  background: #ffffff; border-radius: 24rpx; padding: 24rpx;
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 5px 5px 10px #cfd6e0, -5px -5px 10px #ffffff;
}
.device-name { font-size: 30rpx; font-weight: 600; color: #4a5568; }
.device-meta { display: flex; justify-content: space-between; margin-top: 10rpx; }
.fw { color: #8a94a6; font-size: 24rpx; margin-right: 12rpx; }
.addr { color: #8a94a6; font-size: 20rpx; font-family: monospace; }
.scan-btn {
  background: #ffffff; color: #60a5fa; font-size: 30rpx; font-weight: 600;
  border-radius: 20rpx; padding: 14rpx 32rpx; border: none;
  box-shadow: 4px 4px 8px #cfd6e0, -4px -4px 8px #ffffff;
}
.scan-btn:active {
  box-shadow: inset 3px 3px 6px #cfd6e0, inset -3px -3px 6px #ffffff;
}