<view class="page">
  <!-- 空态：占位图 + 「添加设备」主按钮 -->
  <view wx:if="{{devices.length === 0 && !flow}}" class="empty">
    <view class="empty-illustration">
      <view class="empty-illustration-inner">💡</view>
    </view>
    <view class="empty-title">还没有设备</view>
    <view class="empty-desc">扫描并连接身边的 BLE 灯控器，开始编排灯效</view>
    <button class="btn-add" bindtap="onTapAdd">添加设备</button>
  </view>

  <!-- 有设备：设备卡片列表 -->
  <view wx:if="{{devices.length > 0}}" class="cards">
    <view
      wx:for="{{devices}}"
      wx:for-item="device"
      wx:key="name"
      class="device-card {{selected === device.name ? 'selected' : ''}}"
      data-name="{{device.name}}"
      data-device-id="{{device.deviceId || ''}}"
      bindtap="onTapCard"
      bindlongpress="onLongPress"
    >
      <view class="cover cover-{{device.cover}}">
        <text class="cover-icon">{{device.cover === 'a' ? '💡' : (device.cover === 'b' ? '🎛' : (device.cover === 'c' ? '🎚' : '✨'))}}</text>
      </view>
      <view class="body">
        <view class="name">{{device.label || device.name}}</view>
        <view class="summary">
          <text class="online {{device.online ? 'on' : 'off'}}">{{device.online ? '在线' : '离线'}}</text>
          <text class="count">{{device.pinCount}} 引脚 · {{device.groupCount}} 灯组</text>
        </view>
      </view>
    </view>

    <!-- 末尾追加「+」添加卡片 -->
    <view class="device-card card-add" bindtap="onTapAdd">
      <view class="cover cover-add"><text class="cover-icon">＋</text></view>
      <view class="body"><view class="name add-label">添加设备</view></view>
    </view>
  </view>

  <!-- 添加设备流程：扫描 / 连接 -->
  <view wx:if="{{flow}}" class="add-flow">
    <view class="add-flow-head">
      <text class="add-flow-title">{{flow === 'connecting' ? '连接中…' : '扫描附近设备'}}</text>
      <text class="add-flow-close" bindtap="onTapAdd">停止</text>
    </view>

    <view wx:if="{{addError}}" class="error">{{addError}}</view>

    <view wx:if="{{flow === 'scanning'}}" class="scan-list">
      <view wx:if="{{discovered.length === 0}}" class="scan-empty">
        {{scanning ? '正在扫描…' : '未发现设备，点击「停止」后重试'}}
      </view>
      <view
        wx:for="{{discovered}}"
        wx:for-item="found"
        wx:key="deviceId"
        class="scan-row"
        data-device-id="{{found.deviceId}}"
        data-name="{{found.name}}"
        bindtap="onTapAddDevice"
      >
        <text class="scan-name">{{found.name || '未知设备'}}</text>
        <text class="scan-meta">{{found.deviceId}}</text>
      </view>
    </view>

    <view wx:if="{{flow === 'connecting'}}" class="connecting">
      <text>正在连接设备…</text>
    </view>
  </view>

  <!-- 长按编辑菜单（底部弹出） -->
  <view wx:if="{{menuOpen}}" class="sheet-mask" bindtap="onMenuClose">
    <view class="sheet" catchtap="noop">
      <view class="sheet-item" data-action="rename" catchtap="onMenuAction">重命名</view>
      <view class="sheet-item" data-action="cover" catchtap="onMenuAction">更换封面</view>
      <view class="sheet-item danger" data-action="delete" catchtap="onMenuAction">删除设备</view>
      <view class="sheet-cancel" catchtap="onMenuClose">取消</view>
    </view>
  </view>

  <!-- 重命名输入 -->
  <view wx:if="{{renameOpen}}" class="rename-mask" bindtap="onRenameCancel">
    <view class="rename-panel" catchtap="noop">
      <view class="rename-title">重命名</view>
      <input class="rename-input" value="{{renameDraft}}" bindinput="onRenameInput" focus />
      <view class="rename-actions">
        <button class="btn-ghost" bindtap="onRenameCancel">取消</button>
        <button class="btn-primary" bindtap="onRenameConfirm">确认</button>
      </view>
    </view>
  </view>

  <!-- 调试（模拟）模式横幅：开启时显示，点按关闭并重启 -->
  <view wx:if="{{mockEnabled}}" class="debug-bar" bindtap="onTapDisableMock">
    <text class="debug-dot">●</text>
    <text class="debug-text">调试模式（模拟设备）</text>
    <text class="debug-action">关闭</text>
  </view>
</view>