<view class="page">
  <view class="toolbar">
    <button class="scan-btn" loading="{{scanning}}" bindtap="onTapScan">
      {{scanning ? '停止扫描' : '扫描设备'}}
    </button>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{devices.length === 0 && !scanning}}" class="empty">
    <text>未发现设备。点击“扫描设备”发现广播 ML-XXXX 的灯控器。</text>
  </view>

  <view class="list">
    <view
      wx:for="{{devices}}"
      wx:for-item="device"
      wx:key="deviceId"
      class="device-card"
      data-device-id="{{device.deviceId}}"
      data-item-name="{{device.name}}"
      bindtap="onTapDevice"
    >
      <view class="device-name">{{device.name || '未知设备'}}</view>
      <view class="device-meta">
        <text class="fw">固件 v{{device.major === null ? '?' : device.major}}.{{device.minor === null ? '?' : device.minor}}</text>
        <text class="addr">{{device.deviceId}}</text>
      </view>
    </view>
  </view>
</view>
