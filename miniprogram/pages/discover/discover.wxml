<view class="page">
  <view class="toolbar">
    <button class="scan-btn" type="primary" loading="{{scanning}}" bindtap="{{scanning ? 'stopScan' : 'startScan'}}">
      {{scanning ? '停止扫描' : '扫描设备'}}
    </button>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{devices.length === 0 && !scanning}}" class="empty">
    <text>未发现设备。点击“扫描设备”发现广播 ML-XXXX 的灯控器。</text>
  </view>

  <view class="list">
    <view
      wx:for="{{devices}}"
      wx:key="deviceId"
      class="device-card"
      data-deviceId="{{item.deviceId}}"
      data-name="{{item.name}}"
      bindtap="onTapDevice"
    >
      <view class="device-name">{{item.name || '未知设备'}}</view>
      <view class="device-meta">
        <text class="fw">固件 v{{item.major === null ? '?' : item.major}}.{{item.minor === null ? '?' : item.minor}}</text>
        <text class="addr">{{item.deviceId}}</text>
      </view>
    </view>
  </view>
</view>
