/* 固件升级页：新拟物化（#e0e5ec 底 / #ffffff 卡片 / 柔和双阴影 / 强调 #60a5fa） */
.page { padding: 24rpx; background: #e0e5ec; min-height: 100vh; color: #4a5568; }
.topbar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx;
  background: #ffffff; border-radius: 24rpx; padding: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff; }
.name { font-size: 34rpx; font-weight: 600; color: #4a5568; }
.badge { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 999rpx; }
.badge.ok { background: #e6f0fd; color: #3b82f6; }
.badge.bad { background: #fdeaea; color: #d66a6a; }
.panel { background: #ffffff; border-radius: 24rpx; padding: 24rpx; margin-bottom: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff; }
.panel-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; color: #4a5568; }
.btn { margin: 12rpx 0; height: 80rpx; background: #ffffff; color: #60a5fa; font-size: 28rpx; font-weight: 600;
  border-radius: 16rpx; border: none;
  box-shadow: 4rpx 4rpx 8rpx #cfd6e0, -4rpx -4rpx 8rpx #ffffff; }
.btn:active { box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff; }
.btn.primary { color: #60a5fa; }
.file-row { display: flex; justify-content: space-between; margin: 12rpx 0; font-size: 26rpx; color: #4a5568; }
.progress-box { margin: 20rpx 0; }
.row { display: flex; justify-content: space-between; margin-top: 8rpx; font-size: 26rpx; }
.msg { display: block; margin-top: 16rpx; font-size: 26rpx; color: #d66a6a; }
.msg.muted, .muted { color: #8a94a6; }
.back { margin-left: auto; font-size: 26rpx; color: #60a5fa; }
.hint-bar { margin-top: 16rpx; background: #fdf3e3; color: #b45309; padding: 16rpx 24rpx;
  border-radius: 16rpx; font-size: 26rpx; }