.page { padding: 24rpx; color: #e5e7eb; }
.topbar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.name { font-size: 34rpx; font-weight: 600; }
.badge { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 999rpx; }
.badge.ok { background: #14532d; color: #86efac; }
.badge.bad { background: #7f1d1d; color: #fca5a5; }
.panel { background: #1f2937; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.panel-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.btn { margin: 12rpx 0; }
.btn.primary { background: #2563eb; color: #fff; }
.file-row { display: flex; justify-content: space-between; margin: 12rpx 0; font-size: 26rpx; }
.progress-box { margin: 20rpx 0; }
.row { display: flex; justify-content: space-between; margin-top: 8rpx; font-size: 26rpx; }
.msg { display: block; margin-top: 16rpx; font-size: 26rpx; color: #fca5a5; }
.msg.muted, .muted { color: #9ca3af; }
