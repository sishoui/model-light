<view class="page">
  <view class="toolbar">
    <text class="toolbar-title">8 引脚（可命名）</text>
    <view class="group-picker">
      <text class="label">灯组：</text>
      <view wx:for="{{groups}}" wx:key="*this" class="chip {{item === selectedGroup ? 'active' : ''}}" data-group="{{item}}" bindtap="onSelectGroup">
        {{item}}
      </view>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="pins">
    <view wx:for="{{pins}}" wx:key="index" class="pin-card">
      <view class="pin-header">
        <view class="pin-title" bindtap="onTapPinName" data-pin="{{item.index}}">{{item.name}}</view>
        <input
          wx:if="{{renamingPin === item.index}}"
          class="rename-input"
          value="{{item.name}}"
          bindconfirm="onRenameConfirm"
          bindblur="onRenameConfirm"
          data-pin="{{item.index}}"
        />
        <view wx:if="{{renamingPin === item.index}}" class="rename-actions">
          <text class="rename-btn" bindtap="onRenameCancel">取消</text>
        </view>
      </view>
      <view class="leds">
        <view
          wx:for="{{item.leds}}"
          wx:key="index"
          class="led {{selected ? 'selected' : ''}} {{occupied ? 'occupied' : ''}}"
          data-pin="{{item.index}}" data-led="{{index}}"
          bindtap="onTapLed"
        ></view>
      </view>
    </view>
  </view>

  <view class="footer">
    <button type="primary" bindtap="onPreviewSelection">预览选中像素</button>
  </view>
</view>
