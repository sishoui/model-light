/* 引脚编辑页：新拟物化（#e0e5ec 底 / #ffffff 卡片 / 柔和双阴影 / 强调 #60a5fa） */
.page { padding: 24rpx; background: #e0e5ec; min-height: 100vh; }
.panel { background: #ffffff; border-radius: 24rpx; padding: 24rpx; margin-bottom: 24rpx;
  box-shadow: 5rpx 5rpx 10rpx #cfd6e0, -5rpx -5rpx 10rpx #ffffff; }
.panel-title { color: #4a5568; font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.field { margin-bottom: 20rpx; }
.k { color: #8a94a6; font-size: 24rpx; display: block; margin-bottom: 8rpx; }
.input { background: #ffffff; color: #4a5568; border: none; border-radius: 12rpx; padding: 12rpx 20rpx; font-size: 28rpx;
  box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff; }
.save-btn { margin-top: 16rpx; background: #ffffff; color: #60a5fa; font-size: 24rpx; font-weight: 600;
  border-radius: 14rpx; border: none;
  box-shadow: 4rpx 4rpx 8rpx #cfd6e0, -4rpx -4rpx 8rpx #ffffff; }
.save-btn:active { box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff; }
.error { color: #d66a6a; font-size: 24rpx; }
.group-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #e6eaf0; }
.group-row:last-child { border-bottom: none; }
.group-info { flex: 1; }
.group-name { color: #4a5568; font-size: 28rpx; display: block; }
.group-meta { color: #8a94a6; font-size: 24rpx; }
.del-btn { background: #ffffff; color: #d66a6a; font-size: 22rpx; border: none; border-radius: 12rpx;
  box-shadow: 3rpx 3rpx 6rpx #cfd6e0, -3rpx -3rpx 6rpx #ffffff; }
.del-btn:active { box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff; }
.empty { color: #8a94a6; font-size: 26rpx; padding: 24rpx 0; }
.add-btn { margin-top: 20rpx; background: #ffffff; color: #60a5fa; font-size: 26rpx; font-weight: 600;
  border-radius: 16rpx; border: none;
  box-shadow: 4rpx 4rpx 8rpx #cfd6e0, -4rpx -4rpx 8rpx #ffffff; }
.add-btn:active { box-shadow: inset 3rpx 3rpx 6rpx #cfd6e0, inset -3rpx -3rpx 6rpx #ffffff; }