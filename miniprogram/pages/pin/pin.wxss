.page { padding: 24rpx; }
.panel { background: #1f2937; border-radius: 16rpx; padding: 24rpx; border: 1rpx solid #374151; margin-bottom: 24rpx; }
.panel-title { color: #f9fafb; font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.field { margin-bottom: 20rpx; }
.k { color: #9ca3af; font-size: 24rpx; display: block; margin-bottom: 8rpx; }
.input { background: #111827; color: #f9fafb; border: 1rpx solid #374151; border-radius: 12rpx; padding: 12rpx 16rpx; font-size: 28rpx; }
.save-btn { margin-top: 12rpx; background: #2563eb; color: #fff; font-size: 24rpx; }
.error { color: #f87171; font-size: 24rpx; }
.group-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #374151; }
.group-info { flex: 1; }
.group-name { color: #f9fafb; font-size: 28rpx; display: block; }
.group-meta { color: #9ca3af; font-size: 24rpx; }
.del-btn { background: #7f1d1d; color: #fecaca; font-size: 22rpx; }
.empty { color: #6b7280; font-size: 26rpx; padding: 24rpx 0; }
.add-btn { margin-top: 20rpx; background: #065f46; color: #d1fae5; font-size: 26rpx; }
